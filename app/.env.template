# =============================================================================
# V2 HA VOTING APP - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# After running 'terraform apply', fill in the actual values from terraform outputs
#
# To get the values, run:
#   cd infra/terraform/env/dev
#   terraform output
# =============================================================================

# PostgreSQL Configuration (RDS)
# Get from: terraform output postgres_address
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DB_HOST=<REPLACE_WITH_POSTGRES_ENDPOINT>  # Example: v2-lwinux-rds.xxxxx.eu-west-3.rds.amazonaws.com
DB_PORT=5432

# Redis Configuration (ElastiCache)
# Get from: terraform output redis_endpoint
REDIS_HOST=<REPLACE_WITH_REDIS_ENDPOINT>  # Example: v2-lwinux-v2-ha-voting-app-redis-cluster.xxxxx.cache.amazonaws.com
REDIS_PORT=6379

# Application Ports
VOTE_PORT=8080
RESULT_PORT=8081

# =============================================================================
# INSTRUCTIONS:
# =============================================================================
# 1. Apply terraform:
#    cd infra/terraform/env/dev
#    terraform apply
#
# 2. Get outputs:
#    terraform output postgres_address
#    terraform output redis_endpoint
#
# 3. Replace placeholders in this file
#
# 4. Copy to .env:
#    cp .env.template .env
# =============================================================================
